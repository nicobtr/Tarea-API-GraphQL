              "});\r",
              "\r",
              "pm.test('Devuelve Colombia correctamente', function () {\r",
              "    const country = pm.response.json().data.country;\r",
              "    pm.expect(country.name).to.eql('Colombia');\r",
              "    pm.expect(country.capital).to.eql('Bogotá');\r",
              "});\r",
              "\r",
              "pm.test('Tiene todos los campos pedidos', function () {\r",
              "    const country = pm.response.json().data.country;\r",
              "    pm.expect(country).to.have.property('currency');\r",
              "    pm.expect(country).to.have.property('phone');\r",
              "});"
            ],
