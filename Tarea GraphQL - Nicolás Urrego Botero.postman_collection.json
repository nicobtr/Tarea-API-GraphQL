    {
      "name": "Un pais y sus idiomas - Query anidada",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200 OK', function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test('Devuelve Japón con sus idiomas', function () {\r",
              "    const country = pm.response.json().data.country;\r",
              "    pm.expect(country.name).to.eql('Japan');\r",
              "    pm.expect(country.languages).to.be.an('array');\r",
              "    pm.expect(country.languages.length).to.be.above(0);\r",
              "});\r",
              "\r",
              "pm.test('Cada idioma tiene nombre y versión nativa', function () {\r",
              "    const languages = pm.response.json().data.country.languages;\r",
              "    languages.forEach(function(lang) {\r",
              "        pm.expect(lang).to.have.property('name');\r",
              "        pm.expect(lang).to.have.property('native');\r",
              "    });\r",
              "});"
