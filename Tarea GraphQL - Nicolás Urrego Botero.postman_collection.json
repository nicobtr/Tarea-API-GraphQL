  "item": [
    {
      "name": "Mostrar paises",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200 OK', function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test('Devuelve una lista de países', function () {\r",
              "    const body = pm.response.json();\r",
              "    pm.expect(body.data.countries).to.be.an('array');\r",
              "    pm.expect(body.data.countries.length).to.be.above(0);\r",
              "});\r",
              "\r",
              "pm.test('Cada país tiene nombre, capital y moneda', function () {\r",
              "    const countries = pm.response.json().data.countries;\r",
              "    countries.forEach(function(country) {\r",
              "        pm.expect(country).to.have.property('name');\r",
              "        pm.expect(country).to.have.property('capital');\r",
              "        pm.expect(country).to.have.property('currency');\r",
              "    });\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "graphql",
          "graphql": {
            "query": "{\r\n  countries {\r\n    name\r\n    capital\r\n    currency\r\n  }\r\n}",
            "variables": ""
          }
        },
        "url": {
          "raw": "{{graphql_base_url}}/graphql",
          "host": [
            "{{graphql_base_url}}"
          ],
          "path": [
            "graphql"
          ]
        }
      },
      "response": []
    },
    {
