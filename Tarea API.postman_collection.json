        {
          "name": "Crear pelicula",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"id\": \"00000000-0000-0000-0000-000000000000\",\r\n    \"title\": \"My movie\",\r\n    \"original_title\": \"猫の恩返し\",\r\n    \"original_title_romanised\": \"Neko no ongaeshi\",\r\n    \"image\": \"https://image.tmdb.org/t/p/w600_and_h900_bestv2/avPMO5cnaGHgLaNiAIhy33WoQLm.jpg\",\r\n    \"movie_banner\": \"https://image.tmdb.org/t/p/original/d4BTZvckFTthyhGX27LZnWxl0tl.jpg\",\r\n    \"description\": \"Haru, a schoolgirl bored by her ordinary routine, saves the life of an unusual cat and suddenly her world is transformed beyond anything she ever imagined. The Cat King rewards her good deed with a flurry of presents, including a very shocking proposal of marriage to his son! Haru embarks on an unexpected journey to the Kingdom of Cats where her eyes are opened to a whole other world.\",\r\n    \"director\": \"Hiroyuki Morita\",\r\n    \"producer\": \"Toshio Suzuki\",\r\n    \"release_date\": \"2002\",\r\n    \"running_time\": \"75\",\r\n    \"rt_score\": \"89\",\r\n    \"people\": [\r\n        \"https://ghibliapi.vercel.app/people/\"\r\n    ],\r\n    \"species\": [\r\n        \"https://ghibliapi.vercel.app/species/af3910a6-429f-4c74-9ad5-dfe1c4aa04f2\"\r\n    ],\r\n    \"locations\": [\r\n        \"https://ghibliapi.vercel.app/locations/\"\r\n    ],\r\n    \"vehicles\": [\r\n        \"https://ghibliapi.vercel.app/vehicles/\"\r\n    ],\r\n    \"url\": \"https://ghibliapi.vercel.app/films/90b72513-afd4-4570-84de-a56c312fdf81\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{ghibli_api_url}}/films",
              "host": [
                "{{ghibli_api_url}}"
              ],
              "path": [
                "films"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Actualizar pelicula",
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"id\": \"00000000-0000-0000-0000-000000000000\",\r\n    \"title\": \"My movie\",\r\n    \"original_title\": \"Mi pelicula 1.0\",\r\n    \"original_title_romanised\": \"Neko no ongaeshi\",\r\n    \"image\": \"https://image.tmdb.org/t/p/w600_and_h900_bestv2/avPMO5cnaGHgLaNiAIhy33WoQLm.jpg\",\r\n    \"movie_banner\": \"https://image.tmdb.org/t/p/original/d4BTZvckFTthyhGX27LZnWxl0tl.jpg\",\r\n    \"description\": \"Haru, a schoolgirl bored by her ordinary routine, saves the life of an unusual cat and suddenly her world is transformed beyond anything she ever imagined. The Cat King rewards her good deed with a flurry of presents, including a very shocking proposal of marriage to his son! Haru embarks on an unexpected journey to the Kingdom of Cats where her eyes are opened to a whole other world.\",\r\n    \"director\": \"Yo jaja\",\r\n    \"producer\": \"Toshio Suzuki\",\r\n    \"release_date\": \"2002\",\r\n    \"running_time\": \"75\",\r\n    \"rt_score\": \"89\",\r\n    \"people\": [\r\n        \"https://ghibliapi.vercel.app/people/\"\r\n    ],\r\n    \"species\": [\r\n        \"https://ghibliapi.vercel.app/species/af3910a6-429f-4c74-9ad5-dfe1c4aa04f2\"\r\n    ],\r\n    \"locations\": [\r\n        \"https://ghibliapi.vercel.app/locations/\"\r\n    ],\r\n    \"vehicles\": [\r\n        \"https://ghibliapi.vercel.app/vehicles/\"\r\n    ],\r\n    \"url\": \"https://ghibliapi.vercel.app/films/90b72513-afd4-4570-84de-a56c312fdf81\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{ghibli_api_url}}/films/{{filter_id}}",
              "host": [
                "{{ghibli_api_url}}"
              ],
              "path": [
                "films",
                "{{filter_id}}"
              ]
            }
          },
          "response": []
