    {
      "name": "Query params",
      "item": [
        {
          "name": "Solo tres peliculas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{ghibli_api_url}}/films?limit=3",
              "host": [
                "{{ghibli_api_url}}"
              ],
              "path": [
                "films"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "3"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Una pelicula con cuatro campos",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test('Solo devuelve los campos solicitados', function () {\r",
                  "    const body = pm.response.json();\r",
                  "    pm.expect(body).to.have.property('id');\r",
                  "    pm.expect(body).to.have.property('title');\r",
                  "    pm.expect(body).to.have.property('director');\r",
                  "    pm.expect(body).to.have.property('release_date');\r",
                  "});\r",
                  "\r",
                  "pm.test('No incluye campos que no pedimos', function () {\r",
                  "    const body = pm.response.json();\r",
                  "    pm.expect(body).to.not.have.property('description');\r",
                  "    pm.expect(body).to.not.have.property('rt_score');\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{ghibli_api_url}}/films/{{filter_id}}?fields=id,title,director,release_date",
              "host": [
                "{{ghibli_api_url}}"
              ],
              "path": [
                "films",
                "{{filter_id}}"
              ],
              "query": [
                {
                  "key": "fields",
                  "value": "id,title,director,release_date"
                }
              ]
            }
          },
          "response": []
        }
      ]
