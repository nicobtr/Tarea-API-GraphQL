        {
          "name": "Mostrar peliculas",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Con token devuelve 200', function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test('Respuesta tiene una lista de películas', function () {\r",
                  "    const body = pm.response.json();\r",
                  "    pm.expect(body).to.have.property('docs');\r",
                  "    pm.expect(body.docs).to.be.an('array');\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{lotr_token}}",
                  "type": "string"
