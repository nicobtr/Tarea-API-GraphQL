    {
      "name": "CRUD",
      "item": [
        {
          "name": "Peliculas",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test('Respuesta es un array con películas', function () {\r",
                  "    const body = pm.response.json();\r",
                  "    pm.expect(body).to.be.an('array');\r",
                  "    pm.expect(body.length).to.be.above(0);\r",
                  "});\r",
                  "\r",
                  "pm.test('Cada película tiene título y director', function () {\r",
                  "    const body = pm.response.json();\r",
                  "    body.forEach(function(film) {\r",
                  "        pm.expect(film).to.have.property('title');\r",
                  "        pm.expect(film).to.have.property('director');\r",
                  "    });\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{ghibli_api_url}}/films",
              "host": [
                "{{ghibli_api_url}}"
              ],
              "path": [
                "films"
              ]
            }
          },
          "response": []
        },
